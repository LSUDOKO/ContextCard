[TEMPLATE]
# datacards server (packages/server)
DATACARDS_ADMIN_TOKEN=         # required: steward bearer token for the dashboard API (/api/*). The dashboard login IS this token — keep it secret, never ship it to a browser on someone else's machine.
DATAHUB_GMS_URL=               # required: your DataHub GraphQL endpoint, e.g. https://datahub.example.com/api/graphql
#DATAHUB_GMS_TOKEN=            # optional bearer token for the GMS (if your DataHub requires one)
#DATAHUB_USERNAME=datahub      # optional basic-auth user for the GMS (default datahub)
#DATAHUB_PASSWORD=datahub      # optional basic-auth password for the GMS (default datahub)
PORT=4070
DATACARDS_DB_PATH=.dev/datacards.sqlite
DATACARDS_MASTER_KEY=          # optional: 64 hex chars (32 bytes) — encrypts card secrets at rest so reveal/rotate work (unset = hash-only, secrets unrevealable)
DATACARDS_PUBLIC_MCP_BASE=     # public origin used when rendering card URLs, e.g. https://api.example.com (unset = localhost)
DATACARDS_CORS_ORIGINS=        # comma-separated allowed origins for the API, e.g. https://app.example.com
DATACARDS_ALLOWED_HOSTS=       # extra Host headers accepted on /mcp + /c/<secret>/mcp (comma-separated)
#DATACARDS_MCP_RATE_LIMIT=240            # per-card MCP request ceiling per minute
#DATACARDS_MCP_BAD_SECRET_LIMIT=30       # per-IP bad-credential attempt ceiling per minute
#DATACARDS_TRUST_PROXY_HOPS=1  # trusted proxy hops for client-IP rate-limiting (Railway=1; 0 disables XFF trust)
#DATACARDS_SHOP_RATE_LIMIT=20            # per-IP demo-shop checkout ceiling per minute

# Stripe test-mode lane (demo shop + card_credentials/fiat_pay; optional)
#STRIPE_SECRET_KEY=             # Stripe TEST-mode key (sk_test_/rk_test_ ONLY; anything else disables the lane) — enables the shop + payment tools
#STRIPE_WEBHOOK_SECRET=         # Stripe Issuing webhook signing secret (test mode) for real-time authorization decisions; unset = no real-time lane (Stripe auto-approves, the server books in-process)

# Live integration tests (packages/server: `bun test`) — no mocks anywhere: they run
# against the REAL APIs when these are set, and skip with a message otherwise.
#   Stripe suite: needs STRIPE_SECRET_KEY (+ STRIPE_WEBHOOK_SECRET with
#     `stripe listen --forward-to http://localhost:4099/stripe/webhook` running)
#   DataHub suite: needs DATAHUB_GMS_URL (+ DATAHUB_GMS_TOKEN or basic auth)
#DATACARDS_TEST_DATASET_URN=     # real dataset URN for query_data (auto-discovers when unset)
#DATACARDS_TEST_PII_DATASET_URN= # real dataset tagged/glossary'd PII/sensitive for the pii_blocked test
#DATACARDS_TEST_WEBHOOK_PORT=4099 # port the webhook tests listen on (point `stripe listen` here)

# OAuth lane (self-hosted OAuth 2.1 for agent connections; optional)
#DATACARDS_DASHBOARD_BASE=https://app.example.com   # dashboard origin hosting the consent page (default http://localhost:4071)
#DATACARDS_OAUTH_ACCESS_TTL=3600          # OAuth access-token lifetime, seconds
#DATACARDS_OAUTH_REFRESH_TTL=2592000      # OAuth refresh-token lifetime, seconds (30 days)
#DATACARDS_OAUTH_REGISTER_LIMIT=10        # per-IP client-registration ceiling per minute
#DATACARDS_OAUTH_AUTHORIZE_LIMIT=30       # per-IP authorize-request ceiling per minute
#DATACARDS_OAUTH_TOKEN_LIMIT=60           # per-IP token/revoke-request ceiling per minute
#DATACARDS_OAUTH_REDIRECT_HOSTS=                     # if set, restrict https redirect-uri hosts to this comma-separated allowlist
#DATACARDS_OAUTH_ACCEPTED_RESOURCES=                 # extra RFC 8707 resource URIs still honored (comma-separated)

# datacards dashboard (packages/dashboard)
NEXT_PUBLIC_DATACARDS_API=http://localhost:4070/api

# OpenTelemetry (SigNoz, Grafana, Jaeger — any OTLP collector)
#
# For local SigNoz (from casting.yaml):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# For SigNoz Cloud (https://signoz.io):
#   1. Get your ingestion key from SigNoz Cloud dashboard -> Settings -> Ingestion Settings
#   2. Set the endpoint to your region (us, us2, eu, etc.) and the ingestion key header:
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=YOUR_KEY_HERE
#
# All three exporters default to otlp when the endpoint is set.
# Uncomment to force them:
#OTEL_TRACES_EXPORTER=otlp
#OTEL_METRICS_EXPORTER=otlp
#OTEL_LOGS_EXPORTER=otlp
#DATACARDS_OTEL_DEBUG=0                              # set to 1 for verbose OTel SDK logs
